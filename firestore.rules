rules_version = '2';

// Snuffy Firestore security rules.
//
// Defaults:
//   - All access requires authentication.
//   - Users can only mutate documents that are theirs (matched on `userId`,
//     `ownerID`, or document id == uid where appropriate).
//   - Caretaker and dog-walker directories are world-readable to signed-in
//     users so the booking flow can search them, but writes are restricted.
//
// Anything not explicitly allowed is denied by the implicit catch-all at
// the bottom.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isSelf(uid);
      allow create: if isSelf(uid);
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    // ── Pets (and nested health subcollections) ──────────────────────────
    match /Pets/{petId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerID == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerID == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerID == request.auth.uid;

      match /Vaccinations/{docId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/Pets/$(petId)).data.ownerID == request.auth.uid;
      }
      match /PetMedication/{docId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/Pets/$(petId)).data.ownerID == request.auth.uid;
      }
      match /PetDiet/{docId} {
        allow read, write: if isSignedIn()
          && get(/databases/$(database)/documents/Pets/$(petId)).data.ownerID == request.auth.uid;
      }
    }

    // ── Caretakers / Dog Walkers (directory) ─────────────────────────────
    match /caretakers/{uid} {
      allow read:   if isSignedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /dogwalkers/{uid} {
      allow read:   if isSignedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    // ── Booking requests ────────────────────────────────────────────────
    // Pet owner creates the request; assigned caretaker/walker reads it
    // back and toggles status. Both sides may update; only the owner can delete.
    match /scheduleRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.caretakerId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.caretakerId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /dogWalkerRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.dogWalkerId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.dogWalkerId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Community ───────────────────────────────────────────────────────
    match /communityPosts/{postId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /communityEvents/{eventId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    match /communityComments/{commentId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ── Ratings ─────────────────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ── Admin Notifications ─────────────────────────────────────────────
    // Written by the iOS app on signup, read & mutated by the server-side
    // approval Cloud Function (which uses admin credentials and bypasses these rules).
    match /admin_notifications/{token} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
